generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified Boolean   @default(false)
  passwordHash  String?
  displayName   String?
  bio           String?   @db.VarChar(280)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime  @default(now())
  deletedAt     DateTime?

  // Relations
  posts        Post[]
  comments     Comment[]
  sessions     Session[]
  ownedSpaces  Space[]       @relation("SpaceCreator")
  spaceMembers SpaceMember[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Space {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?    @db.VarChar(500)
  avatarUrl    String?
  bannerUrl    String?
  visibility   Visibility @default(PUBLIC)
  categoryTags String[]
  memberCount  Int        @default(0)
  postCount    Int        @default(0)
  rules        Json       @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String

  // Relations
  creator User          @relation("SpaceCreator", fields: [createdBy], references: [id])
  posts   Post[]
  members SpaceMember[]
}

enum Visibility {
  PUBLIC
  RESTRICTED
  PRIVATE
}

model SpaceMember {
  id       String     @id @default(cuid())
  spaceId  String
  userId   String
  role     MemberRole @default(CONTRIBUTOR)
  joinedAt DateTime   @default(now())

  // Relations
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
}

enum MemberRole {
  OWNER
  MODERATOR
  CONTRIBUTOR
  GUEST
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  authorId  String
  spaceId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author   User      @relation(fields: [authorId], references: [id])
  space    Space     @relation(fields: [spaceId], references: [id])
  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  // Relations
  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id])
}
